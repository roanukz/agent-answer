{
  "name": "agent-answer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Knowledge-Base AI-Readiness Linter — paste a KB article, get a 0-100 agent-answerability score. 100% client-side.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "tsc -p tsconfig.smoke.json && node dist-smoke/scripts/smoke.js"
  },
  "dependencies": {
    "turndown": "^7.2.1",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
